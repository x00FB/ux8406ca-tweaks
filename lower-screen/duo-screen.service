[Unit]
Description=Zenbook Duo: lower screen off while keyboard is docked
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/duo-screen watch
# don't leave the lower screen dark if the daemon is stopped
ExecStopPost=-%h/.local/bin/duo-screen on
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
